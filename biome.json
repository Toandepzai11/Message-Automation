{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "root": true,
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDebugger": "off"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "warn",
          "fix": "safe"
        }
      }
    }
  },
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.nx",
      "!!**/.output",
      "!!**/node_modules",
      "!!**/bin",
      "!!**/obj",
      "!!**/TypedSignalR.Client",
      "!!**/*.gen.ts",
      "!!**/TestResults",
      "!!**/gen",
      "!!**/public",
      "vite.config.ts",
      "*.html"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              "react-scan",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  }
}
